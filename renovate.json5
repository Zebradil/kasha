{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
    'schedule:nonOfficeHours',
  ],
  gitIgnoredAuthors: [
    'renovate[bot]@users.noreply.github.com',
    'github-actions[bot]@users.noreply.github.com',
  ],
  // Machine-readable upgrade list for pr-autopilot, which decides a verdict per update
  // class. Without it the class is recovered from the pull request table or from version
  // arithmetic, and a grouped PR — the github-actions group below is one — is exactly where
  // that guesswork gets a class wrong. A PR carrying several upgrades takes the most
  // conservative verdict among them, so the marker is what keeps a digest bump from
  // inheriting a neighbour's escalation.
  //
  // It has to be prHeader: prBodyNotes is compiled once per upgrade, with only that upgrade in
  // scope, so the loop below renders an empty list. prFooter has the right scope but replaces
  // Renovate's own attribution line.
  prHeader: '<!-- pr-autopilot:upgrades [{{#each upgrades}}{"depName":"{{{depName}}}","updateType":"{{{updateType}}}","currentValue":"{{{currentValue}}}","newValue":"{{{newValue}}}","manager":"{{{manager}}}"}{{#unless @last}},{{/unless}}{{/each}}] -->',
  packageRules: [
    // Group PRs for GitHub Action updates into a single PR
    {
      description: "Group GitHub Action updates into a single PR",
      matchManagers: ["github-actions"],
      groupName: "github actions",
      groupSlug: "github-actions",
    },
    // docs/package.json and .github/workflows/docs.yml pin the same docs-kit tag: the workflow
    // runs the help2md the package installs. Last, so it wins over other groups.
    { description: "Bump the docs-kit package and its reusable workflow together", matchPackageNames: ["Zebradil/docs-kit"], groupName: "docs-kit" },
  ],
}
